<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext for podcast audio and RSS feeds, 
         as many older servers don't support HTTPS yet -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
