<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp"
    android:gravity="center">

    <!-- Header Block (Centered) -->
    <LinearLayout
        android:id="@+id/widget_header_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:background="?android:attr/selectableItemBackground">
        
        <TextView
            android:id="@+id/simple_text_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Podcast Title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:fontFamily="@font/space_mono_font"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="marquee"
            android:marqueeRepeatLimit="marquee_forever"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollHorizontally="true" />

        <TextView
            android:id="@+id/simple_text_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 / 00:00"
            android:textColor="#9A9690"
            android:textSize="11sp"
            android:fontFamily="@font/space_mono_font"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Progress Bar (with 22dp margin) -->
    <ImageView
        android:id="@+id/simple_progress_image"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:layout_marginTop="8dp"
        android:layout_marginHorizontal="22dp"
        android:scaleType="fitCenter" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/simple_btn_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="4dp"
            android:src="@drawable/widget_dot_skip_backward"
            android:background="?android:attr/selectableItemBackgroundBorderless" />

        <FrameLayout
            android:id="@+id/simple_btn_play_container"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginHorizontal="28dp">
            <ImageView
                android:id="@+id/simple_btn_play"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/widget_dot_play" />
        </FrameLayout>

        <ImageView
            android:id="@+id/simple_btn_forward"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="4dp"
            android:src="@drawable/widget_dot_skip_forward"
            android:background="?android:attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

</LinearLayout>
