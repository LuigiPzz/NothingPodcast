<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background">

    <!-- EMPTY STATE COVER -->
    <ImageView
        android:id="@+id/widget_empty_cover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp"
        android:paddingVertical="100dp"
        android:scaleType="centerCrop"
        android:src="@drawable/nothing_podcast_empty_cover"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_player_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        android:visibility="visible">

        <!-- Title -->
        <ImageView
            android:id="@+id/widget_header_styled"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:scaleType="fitCenter" />

        <!-- Progress -->
        <ImageView
            android:id="@+id/simple_progress_image"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="14dp"
            android:scaleType="fitCenter" />

        <!-- Times (Left/Right) -->
        <ImageView
            android:id="@+id/widget_times_styled"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:layout_marginTop="0dp"
            android:scaleType="fitCenter" />

        <!-- Controls (Below Progress/Times) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:orientation="horizontal"
            android:gravity="center">

            <ImageView
                android:id="@+id/simple_btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/widget_dot_skip_backward"
                android:scaleType="fitCenter" />

            <FrameLayout
                android:id="@+id/simple_btn_play_container"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginHorizontal="16dp">
                
                <ImageView
                    android:id="@+id/simple_btn_play"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="0dp"
                    android:src="@drawable/widget_dot_play"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <ImageView
                android:id="@+id/simple_btn_forward"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/widget_dot_skip_forward"
                android:scaleType="fitCenter" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
